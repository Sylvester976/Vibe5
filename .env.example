PORT=8080

# Spotify API credentials — get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/callback

# Session cookie signing key (32+ random bytes, base64)
SESSION_SECRET=
# AES-256-GCM key for encrypting stored Spotify tokens at rest (32 random bytes, base64)
TOKEN_ENCRYPTION_KEY=
# HMAC key for signing public widget tokens (32+ random bytes, base64) — kept separate from the keys above
WIDGET_HMAC_SECRET=

# Worker polling cadence and nightly rollup hour (UTC)
POLL_INTERVAL_MINUTES=20
ROLLUP_HOUR_UTC=3

# Overridden by docker-compose's `environment:` block for the api/worker
# containers; only used for connecting from the host (e.g. local, non-docker runs).
DATABASE_URL=postgres://spotify_insights:spotify_insights@localhost:5432/spotify_insights?sslmode=disable
